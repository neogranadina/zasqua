---
pagination:
  data: places
  size: 1
  alias: place
permalink: "/lugar/{{ place.display_name | safeSlug }}/"
layout: base.njk
eleventyComputed:
  title: "{{ place.display_name }}"
---

{# Pagefind metadata for place index #}
<div style="display:none">
  <span data-pagefind-filter="place_type">{{ place.place_type }}</span>
  <span data-pagefind-filter="has_coordinates">{% if place.latitude and place.longitude %}true{% else %}false{% endif %}</span>
  <span data-pagefind-filter="has_authority">{% if place.wikidata_id or place.whg_id or place.tgn_id or place.hgis_id %}true{% else %}false{% endif %}</span>
  <span data-pagefind-sort="name">{{ place.display_name }}</span>
  <span data-pagefind-meta="place_type">{{ place.place_type }}</span>
  <span data-pagefind-meta="has_coordinates">{% if place.latitude and place.longitude %}true{% else %}false{% endif %}</span>
  <span data-pagefind-meta="linked_count">{{ place._linked_count }}</span>
  {% if place.name_variants and place.name_variants.length %}
    <span data-pagefind-meta="name_variants">{{ place.name_variants | join(', ') }}</span>
  {% endif %}
</div>
<div data-pagefind-body style="display:none">
  {{ place.display_name }}
  {% if place.name_variants %}{{ place.name_variants | join(' ') }}{% endif %}
</div>

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore data-pagefind-place-page>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>{{ ui.place.breadcrumbParent }}</span>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>{{ place.display_name }}</span>
  </div>
</nav>

{# Header #}
<div class="detail-header" data-pagefind-ignore>
  <div class="container">
    <h1 class="detail-title font-sans font-semibold text-stone-900">{{ place.display_name }}</h1>
    <div class="detail-meta text-sm text-stone-500">
      <span class="level-badge">{{ ui.place.types[place.place_type] or place.place_type }}</span>
    </div>
  </div>
</div>

{# Two-column layout #}
<div class="detail-content" data-pagefind-ignore>
  <div class="container">
    <div class="desc-layout entity-layout">

      {# Left column: metadata #}
      <div class="desc-metadata">

        {# Section: Identificacion #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.sections.identification }}</h3>

          <div class="detail-field">
            <span class="detail-label">{{ ui.place.fields.name }}</span>
            <span class="detail-value">{{ place.display_name }}</span>
          </div>

          {% if place.name_variants and place.name_variants.length %}
            <div class="detail-field">
              <span class="detail-label">{{ ui.place.fields.nameVariants }}</span>
              <span class="detail-value">{{ place.name_variants | join(', ') }}</span>
            </div>
          {% endif %}

          {% if place.country_code %}
            <div class="detail-field">
              <span class="detail-label">{{ ui.place.fields.countryCode }}</span>
              <span class="detail-value">{{ place.country_code | countryName }}</span>
            </div>
          {% endif %}
        </div>

        {# Section: Identificadores externos (only if at least one authority ID present) #}
        {% if place.wikidata_id or place.whg_id or place.tgn_id or place.hgis_id %}
          <div class="detail-section">
            <h3 class="font-semibold text-stone-400">{{ ui.place.sections.externalIds }}</h3>
            <div class="authority-links">
              {% if place.wikidata_id %}
                <a href="https://www.wikidata.org/wiki/{{ place.wikidata_id }}" target="_blank" rel="noopener" class="authority-pill">
                  Wikidata <span class="material-symbols-outlined" style="font-size: 14px">open_in_new</span>
                </a>
              {% endif %}
              {% if place.tgn_id %}
                <a href="https://vocab.getty.edu/page/tgn/{{ place.tgn_id }}" target="_blank" rel="noopener" class="authority-pill">
                  TGN <span class="material-symbols-outlined" style="font-size: 14px">open_in_new</span>
                </a>
              {% endif %}
              {% if place.whg_id %}
                <a href="https://whgazetteer.org/places/{{ place.whg_id }}/portal" target="_blank" rel="noopener" class="authority-pill">
                  WHG <span class="material-symbols-outlined" style="font-size: 14px">open_in_new</span>
                </a>
              {% endif %}
              {% if place.hgis_id %}
                <span class="authority-pill" title="{{ place.hgis_id }}">
                  HGIS
                </span>
              {% endif %}
            </div>
          </div>
        {% endif %}


        {# Section: Control #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.sections.control }}</h3>
          <div class="detail-field">
            <span class="detail-label">{{ ui.place.fields.placeCode }}</span>
            <span class="detail-value detail-value-mono">{{ place.place_code or place.id }}</span>
          </div>
          {% if place.latitude and place.longitude %}
            <div class="detail-field">
              <span class="detail-label">{{ ui.place.fields.coordinates }}</span>
              <span class="detail-value">{{ place.latitude }}, {{ place.longitude }}</span>
            </div>
          {% endif %}
        </div>

        {# Section: Reutilizacion #}
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.sections.reuse }}</h3>
          <p class="reuse-blurb">Zasqua se inspira en los <a href="https://journal.code4lib.org/articles/13427" target="_blank" rel="noopener">principios FAIR</a> para hacer sus registros de autoridad más abiertos y reutilizables. Utiliza el formato <a href="https://github.com/LinkedPasts/linked-places-format" target="_blank" rel="noopener">Linked Places</a> para publicar registros geográficos en formato interoperable.</p>
          <div class="reuse-manifest">
            <strong class="reuse-manifest-label">Linked Places</strong>
            <div class="reuse-manifest-row">
              <code class="reuse-manifest-url reuse-coming-soon">Disponible próximamente</code>
            </div>
          </div>
        </div>

      </div>

      {# Right column: aside with map/timeline #}
      <div class="desc-aside">
        <div class="detail-section">
          <h3 class="font-semibold text-stone-400">{{ ui.place.linkedDescriptions }}</h3>

          {# Intro sentence with view links #}
          <p class="entity-intro" id="place-intro"
             data-place-type="{{ ui.place.types[place.place_type] or place.place_type }}"
             data-place-id="{{ place.id }}"
             data-count="{{ place._linked_count }}">
          </p>

          {# Segmented control for view switching #}
          {% if place.latitude and place.longitude %}
            <div class="entity-view-toggle" id="place-view-toggle">
              <button type="button" class="entity-toggle-btn active" data-view="map">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Mapa de ubicación
              </button>
              <button type="button" class="entity-toggle-btn" data-view="timeline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Línea de tiempo
              </button>
            </div>
          {% else %}
            <div class="entity-view-toggle" id="place-view-toggle">
              <button type="button" class="entity-toggle-btn active" data-view="timeline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Línea de tiempo
              </button>
            </div>
          {% endif %}

          <div class="entity-role-filters" id="place-role-filters"></div>

          {# Map view #}
          {% if place.latitude and place.longitude %}
            <div class="place-map-frame" id="place-map-frame">
              <div class="place-map" id="place-map" data-lat="{{ place.latitude }}" data-lon="{{ place.longitude }}"></div>
            </div>
          {% endif %}

          {# Timeline view #}
          <div class="entity-timeline-frame" id="place-timeline-frame" style="display: none">
            <div class="entity-timeline" id="place-timeline" data-place-id="{{ place.id }}">
              <p class="text-stone-500 text-sm">{{ ui.general.loading }}</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>

{% block head %}
  {% if place.latitude and place.longitude %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" />
    <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.js"></script>
    <script type="module">
      import { Protocol } from 'https://cdn.jsdelivr.net/npm/pmtiles@4/dist/pmtiles.js';
      const protocol = new Protocol();
      maplibregl.addProtocol('pmtiles', protocol.tile);
    </script>
  {% endif %}
{% endblock %}

{% block scripts %}
  <script src="/js/place.js"></script>
{% endblock %}
