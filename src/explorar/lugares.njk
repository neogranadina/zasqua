---
layout: base.njk
title: "Explorar lugares"
permalink: /lugares/
---

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>Explorar lugares</span>
  </div>
</nav>

<div class="container font-sans" data-pagefind-ignore>
  {# Page title + intro (D-04) #}
  <h1 class="font-display text-[1.75rem]" style="margin-bottom: 0.5rem">Explorar lugares</h1>
  <p class="text-stone-600 text-base" style="margin-bottom: 1.5rem">Explora los {{ places | length | numberFormat }} lugares vinculados a las descripciones de Zasqua. Busca por nombre, filtra por tipo de lugar o por la presencia de coordenadas geográficas y vínculos de autoridad.</p>

  {# Explorer container — JS renders all dynamic content here #}
  <div id="place-explorer"
       data-place-types='{{ ui.place.types | dump | safe }}'>
  </div>
</div>

{% block head %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.css" />
  <script src="https://cdn.jsdelivr.net/npm/maplibre-gl@5/dist/maplibre-gl.js"></script>
{% endblock %}

{% block scripts %}
  <script src="/js/place-explorer.js"></script>
{% endblock %}
