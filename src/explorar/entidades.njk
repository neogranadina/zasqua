---
layout: base.njk
title: "Explorar entidades"
permalink: /entidades/
---

{% block head %}
  <script src="https://cdn.jsdelivr.net/npm/force-graph"></script>
{% endblock %}

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>Explorar entidades</span>
  </div>
</nav>

<div class="explorer-page" data-pagefind-ignore>

  {# Page header #}
  <header class="explorer-page-header">
    <h1 class="explorer-page-title">Explorar entidades</h1>
    <p class="explorer-page-intro">
      Explora las <strong id="entity-count-live">92.042</strong> entidades vinculadas a las descripciones de Zasqua.
      Busca por nombre, filtra por tipo, fecha o rol.
    </p>
  </header>

  {# Network graph panel — full width, 450px tall #}
  <section class="explorer-graph-panel entity-graph-frame">
    <div id="graph-container" style="width:100%;height:100%"></div>
    <div id="graph-legend" class="graph-legend"></div>
    <div id="graph-tooltip" class="graph-tooltip" style="display:none"></div>
    {# Filter-by-viewport toggle — sits bottom-right of the graph panel.
       Mirrors the place explorer's "Filtrar por área del mapa" button. #}
    <button type="button"
            id="viewport-filter-toggle"
            class="explorer-graph-action"
            aria-pressed="false">
      Filtrar por vista del explorador
    </button>
  </section>

  {# Three-column grid: filters | results | selected entity #}
  <div class="explorer-grid">

    {# Left column — filters #}
    <aside class="explorer-filters-col">
      {# Search input — filled by JS #}
      <div id="entity-search-input" class="explorer-filter-search"></div>

      {# Facets (entity type, date) — filled by JS #}
      <div id="sidebar-facets"></div>
    </aside>

    {# Middle column — results #}
    <div class="explorer-results-col">
      {# Search results, active filter pills, sort, pagination #}
      <div id="entity-explorer"
           data-entity-types='{{ ui.entity.types | dump | safe }}'></div>
    </div>

    {# Right column — selected entity card (sticky) #}
    <aside class="explorer-selected-col">
      <div id="focal-entity-card" class="selected-entity-card">
        <div class="selected-entity-stub">Selecciona una entidad para ver más detalles</div>
      </div>
    </aside>

  </div>

</div>

{% block scripts %}
  <script src="/js/infinite-bipartite-explorer.js"></script>
  <script src="/js/entity-explorer.js"></script>
  <script>
    (function() {
      'use strict';

      var graphContainer = document.getElementById('graph-container');
      var sidebarContainer = document.getElementById('entity-explorer');

      var graph = new InfiniteBipartiteExplorer(graphContainer);
      var sidebar = new EntityExplorer(sidebarContainer);

      // D-13: Graph -> Sidebar: when graph refocuses on entity, update sidebar
      graph.onEntityFocused = function(entityCode, entityMeta, shard) {
        sidebar.highlightEntity(entityCode, entityMeta, shard);
      };

      // Focal-card role filter -> graph: filter docs hanging off focal entity
      sidebar.onFocalRoleFilterChanged = function(rolesSet) {
        graph.setFocalRoleFilter(rolesSet);
      };

      // X on the selected-entity card → tell the graph to drop its selection
      sidebar.onFocalCleared = function() {
        graph.dismissTooltip && graph.dismissTooltip();
      };

      // Graph -> Sidebar: shade the selected-entity card if the focal entity
      // is currently filtered out by the active filter combination.
      graph.onFocalVisibilityChanged = function(visible) {
        var card = document.getElementById('focal-entity-card');
        if (!card) return;
        if (visible) {
          card.classList.remove('is-excluded');
        } else {
          card.classList.add('is-excluded');
        }
      };

      // D-14: Sidebar -> Graph: when user clicks entity in sidebar, load in graph
      sidebar.onEntitySelected = function(entityCode) {
        graph.refocusOn(entityCode);
      };

      // D-08, D-09, D-15: Sidebar -> Graph: when filters/search change, filter graph
      sidebar.onFilterChanged = function(filters) {
        graph.applyFilters(filters);
      };

      // Wire viewport filter — sidebar reads visible entity codes (and full
      // entity records for the fast viewport-only render path) from the
      // graph via these callbacks when its viewportFilter state is on.
      sidebar._visibleCodeSource = function() { return graph.getVisibleEntityCodes(); };
      sidebar._visibleEntitiesSource = function() { return graph.getVisibleEntities(); };

      // Toggle button on the bottom-right of the graph panel.
      var viewportToggle = document.getElementById('viewport-filter-toggle');
      var rerunDebounced = null;
      if (viewportToggle) {
        viewportToggle.addEventListener('click', function() {
          sidebar.viewportFilter = !sidebar.viewportFilter;
          viewportToggle.classList.toggle('is-active', sidebar.viewportFilter);
          viewportToggle.setAttribute('aria-pressed', sidebar.viewportFilter ? 'true' : 'false');
          viewportToggle.textContent = sidebar.viewportFilter
            ? 'Filtrando por vista del explorador'
            : 'Filtrar por vista del explorador';
          sidebar.state.page = 1;
          sidebar.search();
        });
      }

      // Initialise both — graph first (renders immediately), sidebar async (Pagefind WASM)
      graph.init();
      sidebar.init();

      // After graph.initGraph() has run (synchronously inside init()),
      // graphInstance exists. Wrap its onZoom so the viewport-filtered list
      // re-runs whenever the user pans or zooms. Force-graph fires onZoom
      // on every interaction step, so debounce the re-run.
      if (graph.graphInstance && typeof graph.graphInstance.onZoom === 'function') {
        graph.graphInstance.onZoom(function() {
          graph.updateTooltipPosition && graph.updateTooltipPosition();
          if (!sidebar.viewportFilter) return;
          clearTimeout(rerunDebounced);
          rerunDebounced = setTimeout(function() { sidebar.search(); }, 250);
        });
      }

      // After Pagefind init resolves, replace the live entity count placeholder
      sidebar.onReady = function() {
        var el = document.getElementById('entity-count-live');
        if (el && typeof sidebar.getTotalEntityCount === 'function') {
          var n = sidebar.getTotalEntityCount();
          if (n > 0) el.textContent = n.toLocaleString('es-CO');
        }
      };
    })();
  </script>
{% endblock %}
