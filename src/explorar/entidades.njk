---
layout: base.njk
title: "Explorar entidades"
permalink: /entidades/
---

{% block head %}
  <script src="https://cdn.jsdelivr.net/npm/force-graph"></script>
{% endblock %}

{# Breadcrumb #}
<nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore>
  <div class="container">
    <a href="/">{{ ui.breadcrumb.home }}</a>
    <span class="breadcrumb-separator">&rsaquo;</span>
    <span>Explorar entidades</span>
  </div>
</nav>

{# Viewport-filling app layout (D-01, D-05, D-06) #}
<div class="explorer-app" data-pagefind-ignore>

  {# Sidebar: filter section + entity index (D-02, D-03) #}
  <div class="explorer-sidebar">

    {# Filter section at top of sidebar (D-07) #}
    <div class="explorer-sidebar-filters">
      <h2 class="explorer-sidebar-heading">Explorar entidades</h2>
      {# Role filter pills — filled by JS (Plan 02) #}
      <div id="role-filters" class="entity-role-filters"></div>
      {# Facets (entity type, function, date) — filled by JS (Plan 03) #}
      <div id="sidebar-facets"></div>
    </div>

    {# Entity index fills the rest of the sidebar (D-11) #}
    <div class="explorer-sidebar-index">
      {# Focal entity card — shown when an entity is focused in the graph (D-13) #}
      <div id="focal-entity-card"></div>
      {# Entity search + results — Pagefind-powered via entity-explorer.js (D-11) #}
      <div id="entity-explorer"
           data-entity-types='{{ ui.entity.types | dump | safe }}'></div>
    </div>

  </div>

  {# Graph panel fills the remaining viewport width (D-01, D-47) #}
  <div class="explorer-graph entity-graph-frame">
    <div id="graph-container" style="width:100%;height:100%"></div>
    <div id="graph-legend" class="graph-legend"></div>
    <div id="graph-tooltip" class="graph-tooltip" style="display:none"></div>
  </div>

</div>

{% block scripts %}
  <script src="/js/infinite-bipartite-explorer.js"></script>
  <script src="/js/entity-explorer.js"></script>
  <script>
    // Wiring between graph and sidebar happens in Plan 03.
    var graphContainer = document.getElementById('graph-container');
    var sidebarContainer = document.getElementById('entity-explorer');
  </script>
{% endblock %}
